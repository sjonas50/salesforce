<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Notify_Owner_High_Value</fullName>
        <description>Notify owner of high value account</description>
        <protected>false</protected>
        <recipients><type>owner</type></recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/High_Value_Account</template>
    </alerts>
    <fieldUpdates>
        <fullName>MarkStrategic</fullName>
        <field>IsStrategic__c</field>
        <literalValue>1</literalValue>
        <name>Mark Strategic</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>NotifyOwnerOfHighValue</fullName>
        <actions><name>Notify_Owner_High_Value</name><type>Alert</type></actions>
        <actions><name>MarkStrategic</name><type>FieldUpdate</type></actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.AnnualRevenue</field>
            <operation>greaterThan</operation>
            <value>10000000</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
