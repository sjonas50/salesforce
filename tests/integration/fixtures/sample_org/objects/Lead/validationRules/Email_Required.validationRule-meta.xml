<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Required</fullName>
    <active>true</active>
    <description>Web leads must carry an email address.</description>
    <errorConditionFormula>AND(ISPICKVAL(LeadSource, "Web"), ISBLANK(Email), NOT($Permission.Bypass_Validation))</errorConditionFormula>
    <errorDisplayField>Email</errorDisplayField>
    <errorMessage>Email is required for web leads.</errorMessage>
</ValidationRule>
