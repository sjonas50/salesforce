<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <label>Lead Routing</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <object>Lead</object>
        <triggerType>RecordAfterSave</triggerType>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><stringValue>Open</stringValue></value>
        </filters>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <connector><targetReference>RouteByCountry</targetReference></connector>
    </start>
    <formulas>
        <name>IsEnterprise</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.AnnualRevenue} &gt; 5000000 &amp;&amp; NOT(ISBLANK({!$Record.Industry}))</expression>
    </formulas>
    <variables>
        <name>scoreOut</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
    </variables>
    <decisions>
        <name>RouteByCountry</name>
        <label>Route By Country</label>
        <defaultConnector><targetReference>ScoreLead</targetReference></defaultConnector>
        <rules>
            <name>IsUS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>US</stringValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsEnterprise</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>AssignOwner</targetReference></connector>
        </rules>
    </decisions>
    <recordLookups>
        <name>FindTerritory</name>
        <object>Territory__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Country__c</elementReference></value>
        </filters>
        <queriedFields>Owner__c</queriedFields>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector><targetReference>AssignOwner</targetReference></connector>
    </recordLookups>
    <recordUpdates>
        <name>AssignOwner</name>
        <inputReference>$Record</inputReference>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>FindTerritory.Owner__c</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Routed__c</field>
            <value><booleanValue>true</booleanValue></value>
        </inputAssignments>
        <connector><targetReference>ScoreLead</targetReference></connector>
    </recordUpdates>
    <actionCalls>
        <name>ScoreLead</name>
        <actionName>LeadScoringService</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>leadId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <connector><targetReference>NotifyOwner</targetReference></connector>
    </actionCalls>
    <subflows>
        <name>NotifyOwner</name>
        <flowName>SendWelcomeEmail</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
    </subflows>
</Flow>
