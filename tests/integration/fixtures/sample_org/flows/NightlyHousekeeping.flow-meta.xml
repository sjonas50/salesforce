<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <label>Nightly Housekeeping</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <object>Lead</object>
        <triggerType>Scheduled</triggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><stringValue>Dead</stringValue></value>
        </filters>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-01-01</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <connector><targetReference>OldEnough</targetReference></connector>
    </start>
    <decisions>
        <name>OldEnough</name>
        <label>Older than a year?</label>
        <rules>
            <name>Yes</name>
            <conditions>
                <leftValueReference>$Record.LastModifiedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue><elementReference>$Flow.CurrentDate</elementReference></rightValue>
            </conditions>
            <connector><targetReference>DeleteLead</targetReference></connector>
        </rules>
    </decisions>
    <recordDeletes>
        <name>DeleteLead</name>
        <inputReference>$Record</inputReference>
    </recordDeletes>
</Flow>
