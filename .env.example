# Salesforce Off-Ramp environment template.
#
# To use:
#   cp .env.example .env
#   # then fill in the secrets (LLM_API_KEY, SF_CLIENT_ID, …). The .env file is gitignored.
#
# Every key below is read by pydantic-settings (src/offramp/core/config.py) or by a
# script/Makefile named in the comment. Defaults shown are the code defaults; a key
# left empty or missing means "use the default". Keep comments on their own line:
# `KEY=   # note` makes the note the value. In prod these come from Key Vault /
# Secrets Manager via init-container (or OFFRAMP_SECRETS_DIR), never from .env.

# === Salesforce (per-org) ===
# sf CLI alias of the org (`sf org list`); scripts/scratch_org.sh reads it too
SF_ORG_ALIAS=dev_scratch
# jwt (Connected App + private key, production) | sf-cli (reuse `sf org login web` session, local)
SF_AUTH_MODE=jwt
# https://test.salesforce.com for sandboxes
SF_LOGIN_URL=https://login.salesforce.com
# Connected App consumer key (jwt mode only)
SF_CLIENT_ID=
# JWT subject; also the user `offramp verify` traces unless --username is given
SF_USERNAME=integration@example.com
# PEM-encoded RSA private key (jwt mode only)
SF_JWT_KEY_PATH=/secrets/sf_jwt.pem
# pinned (Spring '26, AD-26); never "current"
SF_API_VERSION=66.0
# scripts/scratch_org.sh: address substituted for the fixture's queue/auto-response placeholders (default: the deploying user's email)
SF_SENDER_EMAIL=

# === Pub/Sub API (CDC + Platform Events; year two) ===
SF_PUBSUB_HOST=api.pubsub.salesforce.com:7443
# AD-21: trigger re-sync past this lag
SF_CDC_REPLAY_RECONCILE_THRESHOLD_HOURS=60

# === X-Ray knobs ===
# default process library dir for `offramp kg` / `sync` / `changes` (--library overrides)
OFFRAMP_LIBRARY=~/.offramp/library
# auto | ast | tokenizer — grammar-backed Apex parser (`make apex-parser`) or the tokenizer
OFFRAMP_APEX_ENGINE=auto
# override the parser location (default: tools/apex-parser in the repo)
OFFRAMP_APEX_PARSER_DIR=
# node binary for the parser (default: `node` on PATH)
OFFRAMP_NODE=
# if set and it exists, secrets are read from files in this dir instead of env
OFFRAMP_SECRETS_DIR=

# === Infra (FalkorDB is the only one X-Ray uses today; the rest are year two) ===
# `make falkordb` (no Docker) or the falkordb/falkordb image; scans fall back to in-memory when it is down
FALKORDB_URL=redis://localhost:6379
# Makefile: where the Redis module, data and the browser checkout live
FALKORDB_DIR=~/.local/share/offramp
# Makefile: `make falkordb-browser`
FALKORDB_BROWSER_PORT=3000
POSTGRES_DSN=postgresql://offramp:offramp@localhost:5432/offramp
POSTGRES_SHADOW_DSN=postgresql://offramp:offramp@localhost:5432/offramp_shadow
# redis_streams | azure_event_hubs | nats
EVENT_BUS_BACKEND=redis_streams
REDIS_STREAMS_URL=redis://localhost:6379
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=offramp-dev

# === LLM (X-Ray annotations; Tier 3 agents in year two) ===
# Anthropic by default. `offramp xray` runs the annotation pass unless --skip-annotations;
# it needs LLM_API_KEY. To use a self-hosted or OpenAI-compatible endpoint, override
# LLM_BASE_URL and LLM_MODEL; the annotator routes by the LLM_BASE_URL host.
LLM_BASE_URL=https://api.anthropic.com
# sk-ant-… (the code reads this key, not ANTHROPIC_API_KEY)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# Required when the key is an organization-level key ("not scoped to a workspace"): Console → Settings → Workspaces → ID (wrkspc_…)
LLM_WORKSPACE_ID=
# per annotation call
LLM_MAX_TOKENS=1024
# client-side rate guard
LLM_REQUESTS_PER_MINUTE=50

# === Provenance ===
# stub backend today
ENGRAM_API_URL=http://localhost:8088
F44_NETWORK=base-sepolia                        # base-sepolia | base-mainnet

# === Observability ===
DATADOG_API_KEY=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console for a terminal, json for CI / production
LOG_FORMAT=console
